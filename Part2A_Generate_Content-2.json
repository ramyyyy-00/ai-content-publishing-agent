    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const f = $json;\nconst prompt = `You are the communications officer of Impact Circles, a research organization.\nUsing ONLY the facts below (never invent numbers, names or results), write three versions of the same update.\n\nProject title: ${f['Project title']}\nUpdate type: ${f['Update type']}\nDetails: ${f['Details']}\n\nReturn ONLY a valid JSON object with exactly these keys:\n- linkedin: a professional, engaging LinkedIn post (80-150 words, a short hook, key outcome, 3-4 relevant hashtags, no markdown).\n- newsletter: a concise, informative summary for organizational stakeholders (60-100 words, neutral tone, plain text).\n- website_title: a clear news headline (max 12 words).\n- website_body: a structured news article in markdown with a short intro, a \"Key findings\" or \"What happened\" section as bullet points, and a \"Next steps\" section (150-250 words).`;\nreturn { json: { body: { contents: [{ parts: [{ text: prompt }] }], generationConfig: { responseMimeType: 'application/json' } } } };"
      },
      "id": "24819d72-a33b-4c4f-be28-3f7967748041",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "3b5e4e64-38c7-4840-bac8-bf7b44a82ede",
      "name": "Gemini Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 3000,
      "credentials": {
        "googlePalmApi": {
          "id": "sfCT4X5zG7AYslq5",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const src = $('Submit Project Update').first().json;\nconst raw = $json.candidates?.[0]?.content?.parts?.[0]?.text ?? '';\nlet d;\ntry { d = JSON.parse(raw.replace(/```json|```/g, '').trim()); }\ncatch (e) { throw new Error('Could not parse AI output: ' + raw.slice(0, 200)); }\nconst id = 'C-' + Date.now().toString().slice(-7);\nreturn [{ json: {\n  content_id: id,\n  title: src['Project title'],\n  source_text: src['Details'],\n  linkedin: d.linkedin,\n  newsletter: d.newsletter,\n  website: d.website_title + '\\n\\n' + d.website_body,\n  status: 'PENDING_APPROVAL',\n  channels: '',\n  edited: 'no',\n  created_at: new Date().toISOString(),\n  approved_at: '',\n  published_at: ''\n} }];"
      },
