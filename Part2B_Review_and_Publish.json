    {
      "parameters": {
        "jsCode": "const form = $('Review Form').first().json;\nconst found = $input.all().map(i => i.json).filter(r => r.content_id);\nconst row = found[0];\nif (!row) return [{ json: { action: 'notfound', needs_update: false, message: 'Content ID not found: ' + form['Content ID'] } }];\n\nconst asList = v => Array.isArray(v) ? v : (v ? String(v).split(',').map(s => s.trim()).filter(Boolean) : []);\nconst decision = form['Decision'];\nconst channels = asList(form['Channels']);\nconst eLi = String(form['Edited LinkedIn'] || '').trim();\nconst eNe = String(form['Edited Newsletter'] || '').trim();\nconst eWe = String(form['Edited Website'] || '').trim();\nconst hasEdits = !!(eLi || eNe || eWe) || decision === 'Save edits only';\n\nconst out = {\n  content_id: row.content_id,\n  linkedin: eLi || row.linkedin,\n  newsletter: eNe || row.newsletter,\n  website: eWe || row.website,\n  status: row.status,\n  channels: row.channels || '',\n  edited: row.edited || 'no',\n  approved_at: row.approved_at || ''\n};\n\nif (row.status === 'PUBLISHED')\n  return [{ json: { action: 'blocked', needs_update: false, message: row.content_id + ' is already published.' } }];\n\nif (decision === 'Reject') {\n  out.status = 'REJECTED';\n  return [{ json: { action: 'reject', needs_update: true, row: out, message: row.content_id + ' was rejected. Nothing was published.' } }];\n}\n\nif (hasEdits) {\n  // Any edit resets approval: the content must be approved again before publishing.\n  out.status = 'PENDING_APPROVAL';\n  out.edited = 'yes';\n  out.approved_at = '';\n  return [{ json: { action: 'edit', needs_update: true, row: out,\n    message: 'Edits saved for ' + row.content_id + '. NOT published. Submit the form again with \"Approve & Publish\" to approve the updated version.' } }];\n}\n\nif (!['PENDING_APPROVAL', 'PUBLISH_FAILED'].includes(row.status))\n  return [{ json: { action: 'blocked', needs_update: false, message: row.content_id + ' cannot be approved from status ' + row.status + '.' } }];\n\nif (channels.length === 0)\n  return [{ json: { action: 'blocked', needs_update: false, message: 'Select at least one channel to publish.' } }];\n\nout.status = 'APPROVED';\nout.channels = channels.join(', ');\nout.approved_at = new Date().toISOString();\nreturn [{ json: { action: 'publish', needs_update: true, row: out, message: 'Approved.' } }];"
      },
