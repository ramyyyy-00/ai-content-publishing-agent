        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const calls = $('Build Publish Calls').all();\nreturn $input.all().map((it, i) => {\n  const c = calls[i].json;\n  const ok = it.json.id && !it.json.error;\n  return { json: {\n    content_id: c.content_id,\n    channel: c.channel,\n    status: ok ? 'SUCCESS' : 'FAILED',\n    published_url: ok ? 'https://jsonplaceholder.typicode.com/posts/' + it.json.id : '',\n    timestamp: new Date().toISOString(),\n    message: ok ? 'Published to MOCK API (test mode)' : String((it.json.error && it.json.error.message) || it.json.error || 'Unknown error')\n  } };\n});"
      },
