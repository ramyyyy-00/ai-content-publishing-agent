        "jsCode": "const logs = $input.all().map(i => i.json);\nconst allOk = logs.every(l => l.status === 'SUCCESS');\nreturn [{ json: {\n  content_id: logs[0].content_id,\n  status: allOk ? 'PUBLISHED' : 'PUBLISH_FAILED',\n  published_at: new Date().toISOString(),\n  summary: logs.map(l => l.channel + ': ' + l.status).join(', ')\n} }];"
      },
