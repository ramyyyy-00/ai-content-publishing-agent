    {
      "parameters": {
        "jsCode": "const d = $('Decide').first().json.row;\nconst ch = String(d.channels).split(',').map(s => s.trim()).filter(Boolean);\nreturn ch.map(c => {\n  const text = c === 'LinkedIn' ? d.linkedin : c === 'Newsletter' ? d.newsletter : d.website;\n  const title = c === 'Website' ? String(d.website).split('\\n')[0] : c + ' post ' + d.content_id;\n  return { json: { content_id: d.content_id, channel: c, title, body: text } };\n});"
      },
